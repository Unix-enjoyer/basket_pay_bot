# Скопируй этот файл в .env и заполни своими значениями.
# Файл .env никогда не должен попадать в git (он уже добавлен в .gitignore).

# Токен бота, который выдаёт @BotFather в Telegram при создании бота
BOT_TOKEN=твой_токен_от_botfather

# Твой личный Telegram user_id — ты станешь супер-админом, тебя нельзя будет удалить командой /remove_admin.
# Узнать свой user_id можно, написав боту @userinfobot
SUPER_ADMIN_ID=123456789

# Путь к файлу базы данных (менять не обязательно)
DB_PATH=data/bot.db

# Папка для логов (менять не обязательно)
LOG_DIR=logs

# Цена билета по умолчанию при самом первом запуске бота (потом меняется командой /set_price)
DEFAULT_PRICE=1000

# Номер счёта получателя (поле "Договор получателя" из чека Т-Банка).
# Бот будет сверять этот номер в каждом присланном чеке — если не совпадёт, оплата не примется.
# Оставь пустым, если пока не хочешь эту проверку.
RECEIVER_CONTRACT=8079209614
