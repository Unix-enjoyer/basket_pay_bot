# Базовый образ с Python 3.13 (совпадает с версией, которую ты используешь в PyCharm)
FROM python:3.13-slim

# Рабочая папка внутри контейнера
WORKDIR /app

# Сначала копируем только requirements.txt и ставим зависимости —
# так Docker закэширует этот слой, и при изменении только кода (не зависимостей)
# пересборка образа будет быстрее
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь остальной код проекта
COPY . .

# Команда, которая запускается при старте контейнера
CMD ["python", "main.py"]
